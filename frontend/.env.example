# ============================================================
# QYRO FRONTEND — Environment Variables
# Copy this file to .env and configure for production/development
# ============================================================

# URL of the backend API server
REACT_APP_API_URL=http://localhost:5000/api

# URL of the backend WebSocket server for notifications
REACT_APP_SOCKET_URL=http://localhost:5000

# URL of the admin panel dashboard for redirects
REACT_APP_ADMIN_DASHBOARD_URL=http://localhost:3001/dashboard

# ============================================================
# QYRO BACKEND — Environment Variables
# Copy this file to backend/.env and fill in the values
# NEVER commit .env to version control
# ============================================================

# === DATABASE ===
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/qyrodb?retryWrites=true&w=majority

# === JWT SECURITY ===
JWT_SECRET=<generate-with-openssl-rand-base64-64>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-base64-64>
# JWT_SECRET and JWT_REFRESH_SECRET must be DIFFERENT strong random strings

# === SERVER ===
PORT=5000
NODE_ENV=development
# Set to "production" in deployment

# === CORS — Production URLs ===
PRODUCTION_FRONTEND_URL=https://qyro.vercel.app
PRODUCTION_ADMIN_URL=https://admin.qyro.vercel.app

# === CLOUDINARY (Image Uploads) ===
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# === EMAIL (Nodemailer — for OTP) ===
EMAIL_USER=<your-gmail>@gmail.com
EMAIL_PASS=<your-app-password>
# Use Gmail App Passwords, not your actual password

# === PAYMENT (Razorpay) ===
RAZORPAY_KEY=<your-razorpay-key>
RAZORPAY_SECRET=<your-razorpay-secret>

# === AI FEATURES (Gemini) ===
GEMINI_API_KEY=<your-gemini-api-key>

# ============================================================
# SUPER ADMIN SEED SCRIPT
# Set these ONLY when running: npm run seed:super-admin
# Do NOT commit these values
# ============================================================
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_EMAIL=superadmin@qyro.com
# SUPER_ADMIN_PASSWORD=<strong-password>
